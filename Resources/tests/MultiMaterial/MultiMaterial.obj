mtllib MultiMaterial.mtl

# Closed presentation cuboid. Each object becomes an independent Assimp mesh
# and uses a different material while sharing one combined GPU vertex/index buffer.
v -1.00 -0.75 -0.75
v  1.00 -0.75 -0.75
v  1.00  0.75 -0.75
v -1.00  0.75 -0.75
v -1.00 -0.75  0.75
v  1.00 -0.75  0.75
v  1.00  0.75  0.75
v -1.00  0.75  0.75

vt 0.0 1.0
vt 1.0 1.0
vt 1.0 0.0
vt 0.0 0.0

vn  0.0  0.0 -1.0
vn  0.0  0.0  1.0
vn -1.0  0.0  0.0
vn  1.0  0.0  0.0
vn  0.0  1.0  0.0
vn  0.0 -1.0  0.0

o WarmFrontBack
usemtl RedMaterial
f 1/1/1 3/3/1 2/2/1
f 1/1/1 4/4/1 3/3/1
f 6/1/2 8/3/2 5/2/2
f 6/1/2 7/4/2 8/3/2

o BlueSideShell
usemtl BlueMaterial
f 5/1/3 4/3/3 1/2/3
f 5/1/3 8/4/3 4/3/3
f 2/1/4 7/3/4 6/2/4
f 2/1/4 3/4/4 7/3/4

o CheckerCaps
usemtl CheckerMaterial
f 4/1/5 7/3/5 3/2/5
f 4/1/5 8/4/5 7/3/5
f 5/1/6 2/3/6 6/2/6
f 5/1/6 1/4/6 2/3/6
