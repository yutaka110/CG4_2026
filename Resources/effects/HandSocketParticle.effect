# Continuous GPU emitter attached to an animated hand Bone Socket.
# A zero effect/component duration keeps the emitter alive; GPU particles use
# the shader's bounded default lifetime when the authored duration is zero.
name = hand_socket_particle
shader = Particle
texture = circle2
blend = additive
layer = additive
lifetime = 0
renderQueue = 3075
size = 1.0,1.0,1.0
color = 1.0,1.0,1.0,1.0
particle.emissive = 6.0
particle.noiseStrength = 0.35
particle.uvScrollSpeed = 0.25
particle.pulseSpeed = 5.0
particle.spawnRadius = 0.09
particle.spawnCount = 3
particle.spawnFrequency = 0.04
particle.randomRotation = 1
particle.scaleYMin = 0.35
particle.scaleYMax = 1.15
particle.depthFadeSoftness = 0.008
particle.edgeSoftness = 0.16

