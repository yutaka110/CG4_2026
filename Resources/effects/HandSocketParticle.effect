# Continuous GPU emitter attached to an animated hand Bone Socket.
# A zero effect/component duration keeps the emitter alive, while each GPU
# particle has an explicit bounded lifetime for every render-resource path.
name = hand_socket_particle
shader = Particle
texture = circle2
blend = additive
layer = additive
lifetime = 0
renderQueue = 3075
size = 1.0,1.0,1.0
color = 1.0,1.0,1.0,1.0
particle.emissive = 6.0
particle.lifetime = 0.55
particle.noiseStrength = 0.22
particle.uvScrollSpeed = 0.25
particle.pulseSpeed = 5.0
particle.spawnRadius = 0.045
particle.spawnCount = 7
particle.spawnFrequency = 0.020
particle.randomRotation = 1
particle.scaleYMin = 0.55
particle.scaleYMax = 0.95
particle.depthFadeSoftness = 0.0
particle.edgeSoftness = 0.16

