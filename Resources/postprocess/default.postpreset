# Rail shooter postprocess look preset
pass.BloomExtract.enabled=1
pass.BloomExtract.intensity=1
pass.BloomExtract.bloomThresholdMin=0.62
pass.BloomExtract.bloomThresholdMax=1.35
pass.BloomExtract.bloomSoftKnee=0.16
pass.BloomDownsampleQuarter.enabled=1
pass.BloomBlurHorizontalQuarter.enabled=1
pass.BloomBlurHorizontalQuarter.blurRadius=6
pass.BloomBlurVerticalQuarter.enabled=1
pass.BloomBlurVerticalQuarter.blurRadius=6
pass.BloomDownsampleEighth.enabled=1
pass.BloomBlurHorizontalEighth.enabled=1
pass.BloomBlurHorizontalEighth.blurRadius=4
pass.BloomBlurVerticalEighth.enabled=1
pass.BloomBlurVerticalEighth.blurRadius=4
pass.BloomUpsampleQuarter.enabled=1
pass.BloomUpsampleQuarter.bloomUpsampleBlend=0.68
pass.BloomUpsampleQuarter.bloomUpsampleSoftKnee=0.35
pass.BloomUpsampleHalf.enabled=1
pass.BloomUpsampleHalf.bloomUpsampleBlend=0.55
pass.BloomUpsampleHalf.bloomUpsampleSoftKnee=0.25
pass.GlowComposite.enabled=1
pass.GlowComposite.intensity=0.88
pass.GlowComposite.glowWeight=0.74
pass.GlowComposite.glowTintR=1
pass.GlowComposite.glowTintG=0.95
pass.GlowComposite.glowTintB=1.2
pass.ContactAO.enabled=1
pass.ContactAO.intensity=0.42
pass.ContactAO.contactAoRadiusPixels=3
pass.ContactAO.contactAoBias=0.25
pass.ContactAO.contactAoFalloff=9
pass.ContactAO.contactAoNearPlane=0.1
pass.ContactAO.contactAoFarPlane=5000
pass.DistanceFog.enabled=1
pass.DistanceFog.intensity=0.48
pass.DistanceFog.fogStart=135
pass.DistanceFog.fogEnd=1450
pass.DistanceFog.fogDensity=0.26
pass.DistanceFog.fogColorR=0.42
pass.DistanceFog.fogColorG=0.38
pass.DistanceFog.fogColorB=0.36
pass.DistanceFog.fogDepthBoost=0.42
pass.DistanceFog.fogDepthBoostStart=0.50
pass.DistanceFog.backlitFogLift=0.34
pass.DistanceFog.openingGlowStrength=0.62
pass.DistanceFog.foregroundSilhouetteStrength=0.58
pass.DistanceFog.lowFogLayerStrength=0.30
pass.DistanceFog.coolFloorHazeStrength=0.24
pass.ToneMapping.enabled=1
pass.ToneMapping.intensity=1
pass.ToneMapping.toneExposure=1
